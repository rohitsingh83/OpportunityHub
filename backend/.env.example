# Copy this file to .env and fill in your values.

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# Examples:
#   Local MongoDB : mongodb://127.0.0.1:27017/internship_portal
#   MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/internship_portal
MONGO_URI=mongodb://127.0.0.1:27017/internship_portal

# Dev convenience: set to true to run against a temporary in-memory MongoDB
# (no local mongod installation needed). Handy for quick demos/tests.
USE_IN_MEMORY_DB=false

# BONUS (lightweight admin protection):
# When set, mutating/admin routes require the header  x-admin-key: <ADMIN_KEY>
# Leave commented to run in open dev mode.
# ADMIN_KEY=change-me-to-a-secret
